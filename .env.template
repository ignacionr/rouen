# Environment configuration template for Rouen project
# Copy this file to .env and fill in your actual values
# 
# SECURITY NOTE: The .env file is gitignored and should contain your actual secrets.
# This template file shows the required format and can be safely committed.

# Git executable path (optional - will use system git if not specified)
GIT_PATH=/usr/bin/git

# OpenWeather API Key for weather functionality
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_KEY=your_openweather_api_key_here

# Add other environment variables as needed
# Example:
# SOME_API_KEY=your_api_key_here
# CUSTOM_SETTING=your_value_here