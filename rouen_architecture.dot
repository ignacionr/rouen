digraph RouenArchitecture {
    // Graph settings
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    fontsize=14;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    
    // Color scheme
    bgcolor="white";
    node [style=filled, fillcolor=lightgray];
    
    // Main Application Layer
    subgraph cluster_main {
        label="Main Application & Server Layer";
        color=blue;
        style=filled;
        fillcolor=lightcyan;
        
        main_cpp [label="rouen.cpp\n(Entry Point)", shape=box, fillcolor=lightblue];
        main_wnd [label="main_wnd\n(Main Window)", shape=box, fillcolor=lightblue];
        main_wnd_core [label="main_wnd_core.cpp\n(Core Functions)", shape=box, fillcolor=lightsteelblue];
        main_wnd_init [label="main_wnd_init.cpp\n(Initialization)", shape=box, fillcolor=lightsteelblue];
        main_wnd_loop [label="main_wnd_loop.cpp\n(Event Loop)", shape=box, fillcolor=lightsteelblue];
        main_wnd_theme [label="main_wnd_theme.cpp\n(Theme Setup)", shape=box, fillcolor=lightsteelblue];
        api_server [label="api_server\n(HTTP REST API :8081)", shape=box, fillcolor=gold];
        registrar [label="registrar.hpp\n(Service Registry)", shape=box, fillcolor=orange];
    }
    
    // Core Systems Layer
    subgraph cluster_core {
        label="Core Systems";
        color=darkgreen;
        style=filled;
        fillcolor=lightgreen;
        
        // Card System Core
        subgraph cluster_card_system {
            label="Card System";
            color=darkblue;
            style=filled;
            fillcolor=aliceblue;
            
            card_base [label="card\n(Base Class with render_video_ui)", shape=ellipse, fillcolor=yellow];
            deck [label="deck\n(Card Container)", shape=box, fillcolor=wheat];
            factory [label="factory\n(Card Factory)", shape=diamond, fillcolor=lightpink];
            menu [label="menu\n(Launcher Card)", shape=box, fillcolor=lightcyan];
        }
        
        // Helper Systems
        subgraph cluster_helpers {
            label="Helper Systems";
            color=purple;
            style=filled;
            fillcolor=lavender;
            
            deferred_ops [label="deferred_operations", shape=box];
            config_service [label="config_service", shape=box];
            platform_utils [label="platform_utils", shape=box];
            imgui_helper [label="imgui_helper", shape=box];
            texture_helper [label="texture_helper", shape=box];
            capture_helper [label="capture_helper", shape=box];
            sqlite_service [label="sqlite", shape=box];
            fetch_service [label="fetch", shape=box];
            media_player [label="media_player\n(FFmpeg Decoder & SDL3 Audio)", shape=box, fillcolor=aquamarine];
            stream_encoder [label="stream_encoder\n(H.264 Video & AAC Audio)", shape=box, fillcolor=aquamarine];
            ffmpeg_helper [label="ffmpeg_helper\n(Subprocess Probe)", shape=box];
            process_helper [label="process_helper", shape=box];
        }
    }
    
    // Card Categories
    subgraph cluster_dev_cards {
        label="Development Cards";
        color=darkred;
        style=filled;
        fillcolor=mistyrose;
        
        git_card [label="git\n(Git Repository)", shape=box];
        github_card [label="github\n(GitHub Integration)", shape=box];
        github_ci_card [label="github_ci_card\n(CI/CD Monitoring)", shape=box];
        cmake_card [label="cmake\n(CMake Builder)", shape=box];
        fs_directory [label="fs_directory\n(File Explorer)", shape=box];
        editor_card [label="editor\n(Code Editor)", shape=box];
    }
    
    subgraph cluster_info_cards {
        label="Information Cards";
        color=darkorange;
        style=filled;
        fillcolor=peachpuff;
        
        ai_chat_card [label="ai_chat\n(AI Assistant & MCP Tools)", shape=box, fillcolor=gold];
        number_series [label="number_series\n(Animated Graph Broadcast)", shape=box, fillcolor=gold];
        rss_card [label="rss\n(RSS Dashboard)", shape=box];
        rss_feed [label="rss_feed\n(Feed Reader)", shape=box];
        rss_item [label="rss_item\n(Article Player)", shape=box];
        rss_smart_list [label="rss_smart_list\n(Smart Filter)", shape=box];
        weather_card [label="weather\n(Weather Forecast)", shape=box];
        mail_card [label="mail\n(IMAP/SMTP Mail)", shape=box];
        calendar_card [label="calendar\n(Calendar Sync)", shape=box];
        travel_card [label="travel\n(Travel Guides)", shape=box];
        travel_plan [label="travel_plan\n(Trip Itinerary)", shape=box];
        bybit_assets [label="bybit_assets\n(Crypto Portfolio)", shape=box];
        movies_card [label="movies\n(Movie Database)", shape=box];
        worldcup_card [label="worldcup_dashboard\n(Tournament Stats)", shape=box];
    }
    
    subgraph cluster_productivity_cards {
        label="Productivity Cards";
        color=darkviolet;
        style=filled;
        fillcolor=plum;
        
        pomodoro_card [label="pomodoro\n(Timer)", shape=box];
        alarm_card [label="alarm\n(Alarm & Timer Overlay)", shape=box];
        jira_card [label="jira_card\n(Jira Boards)", shape=box];
        trello_card [label="trello_card\n(Trello Columns)", shape=box];
        converter_card [label="converter\n(Unit Converter)", shape=box];
        notes_card [label="markdown_notes\n(Wiki Notes)", shape=box];
    }
    
    subgraph cluster_media_cards {
        label="Media & Camera Cards";
        color=darkmagenta;
        style=filled;
        fillcolor=thistle;
        
        camera_card [label="camera\n(Live Video & 7 Layout Presets)", shape=box, fillcolor=gold];
        radio_card [label="radio\n(Internet Radio)", shape=box];
        chess_replay [label="chess_replay\n(Chess Games)", shape=box];
    }
    
    subgraph cluster_system_cards {
        label="System & Sync Cards";
        color=darkcyan;
        style=filled;
        fillcolor=lightcyan;
        
        sysinfo_card [label="sysinfo\n(System Info)", shape=box];
        settings_card [label="settings\n(Configuration)", shape=box];
        envvars_card [label="envvars\n(Environment Vars)", shape=box];
        terminal_card [label="terminal\n(PTY Shell)", shape=box];
        dbrepair_card [label="dbrepair\n(Database Repair)", shape=box];
        subnet_scanner [label="subnet_scanner\n(Network Scanner)", shape=box];
        universal_sync [label="universal_sync\n(Native Git Sync)", shape=box];
    }
    
    // Host Integration Layer
    subgraph cluster_hosts {
        label="External Host & Stream Layer";
        color=darkslategray;
        style=filled;
        fillcolor=lightslategray;
        
        video_feed_host [label="VideoFeedHost\n(TCP Unicast Streamer :8889)", shape=hexagon, fillcolor=aquamarine];
        bybit_host [label="bybit_host\n(Bybit API)", shape=hexagon];
        rss_host [label="rss_host\n(RSS Aggregator)", shape=hexagon];
        travel_host [label="travel_host\n(Travel APIs)", shape=hexagon];
        trello_host [label="trello_host\n(Trello API)", shape=hexagon];
        weather_host [label="weather_host\n(Weather API)", shape=hexagon];
    }
    
    // UI Framework Layer
    subgraph cluster_ui {
        label="UI & Audio Framework";
        color=darkslateblue;
        style=filled;
        fillcolor=lightsteelblue;
        
        imgui [label="ImGui\n(UI Engine)", shape=box, fillcolor=lightblue];
        sdl3 [label="SDL3\n(Audio Stream & Windowing)", shape=box, fillcolor=lightblue];
        opengl [label="OpenGL\n(GPU Rendering)", shape=box, fillcolor=lightblue];
        fonts [label="fonts\n(Font Management)", shape=box, fillcolor=lightsteelblue];
    }
    
    // External Dependencies
    subgraph cluster_dependencies {
        label="External Libraries";
        color=brown;
        style=filled;
        fillcolor=lightyellow;
        
        curl [label="libcurl\n(SSL/TLS HTTP Client)", shape=ellipse];
        sqlite [label="SQLite3\n(Embedded DB)", shape=ellipse];
        openssl [label="OpenSSL\n(Crypto & TLS)", shape=ellipse];
        tinyxml2 [label="TinyXML2\n(XML Parser)", shape=ellipse];
        glaze [label="Glaze\n(Fast JSON Parser)", shape=ellipse];
        ffmpeg [label="FFmpeg Libraries\n(avcodec, avformat, swscale, swresample)", shape=ellipse, fillcolor=gold];
    }
    
    // Build System
    subgraph cluster_build {
        label="Build Environment";
        color=saddlebrown;
        style=filled;
        fillcolor=antiquewhite;
        
        cmake [label="CMake 3.31+", shape=box, fillcolor=tan];
        nix [label="Nix Flake & Nix-Shell", shape=box, fillcolor=tan];
    }
    
    // Connections
    main_cpp -> main_wnd [label="creates"];
    main_wnd -> main_wnd_core;
    main_wnd -> main_wnd_init;
    main_wnd -> main_wnd_loop;
    main_wnd -> main_wnd_theme;
    main_wnd -> api_server [label="initializes"];
    main_wnd -> deck [label="manages"];
    main_wnd -> registrar [label="registers services"];
    api_server -> deck [label="dispatches API requests"];
    
    // Card system connections
    deck -> factory [label="uses"];
    deck -> card_base [label="contains active cards"];
    factory -> card_base [label="instantiates"];
    
    // Card inheritance relationships
    card_base -> git_card [style=dashed];
    card_base -> github_card [style=dashed];
    card_base -> github_ci_card [style=dashed];
    card_base -> cmake_card [style=dashed];
    card_base -> fs_directory [style=dashed];
    card_base -> editor_card [style=dashed];
    card_base -> ai_chat_card [style=dashed];
    card_base -> number_series [style=dashed];
    card_base -> rss_card [style=dashed];
    card_base -> rss_feed [style=dashed];
    card_base -> rss_item [style=dashed];
    card_base -> rss_smart_list [style=dashed];
    card_base -> weather_card [style=dashed];
    card_base -> mail_card [style=dashed];
    card_base -> calendar_card [style=dashed];
    card_base -> travel_card [style=dashed];
    card_base -> travel_plan [style=dashed];
    card_base -> bybit_assets [style=dashed];
    card_base -> movies_card [style=dashed];
    card_base -> worldcup_card [style=dashed];
    card_base -> pomodoro_card [style=dashed];
    card_base -> alarm_card [style=dashed];
    card_base -> jira_card [style=dashed];
    card_base -> trello_card [style=dashed];
    card_base -> converter_card [style=dashed];
    card_base -> notes_card [style=dashed];
    card_base -> camera_card [style=dashed];
    card_base -> radio_card [style=dashed];
    card_base -> chess_replay [style=dashed];
    card_base -> sysinfo_card [style=dashed];
    card_base -> settings_card [style=dashed];
    card_base -> envvars_card [style=dashed];
    card_base -> terminal_card [style=dashed];
    card_base -> dbrepair_card [style=dashed];
    card_base -> subnet_scanner [style=dashed];
    card_base -> universal_sync [style=dashed];
    card_base -> menu [style=dashed];
    
    // Host & Video Feed relationships
    video_feed_host -> stream_encoder [label="encodes H.264/AAC"];
    video_feed_host -> card_base [label="invokes render_video_ui()"];
    media_player -> ffmpeg [label="decodes video/audio"];
    media_player -> sdl3 [label="streams audio"];
    stream_encoder -> ffmpeg [label="uses avcodec & swscale"];
    
    // Helper system usage
    deck -> deferred_ops [label="uses"];
    deck -> capture_helper [label="uses"];
    main_wnd -> config_service [label="uses"];
    main_wnd -> platform_utils [label="uses"];
    
    // Framework connections
    main_wnd -> sdl3 [label="window & events"];
    main_wnd -> imgui [label="desktop UI"];
    deck -> imgui [label="renders cards"];
    sdl3 -> opengl [label="context"];
    
    // External dependency connections
    fetch_service -> curl [label="uses"];
    sqlite_service -> sqlite [label="uses"];
    fetch_service -> openssl [label="uses"];
    rss_host -> tinyxml2 [label="uses"];
    config_service -> glaze [label="uses"];
}
