#include <windows.h>

// Application icon
IDI_APPLICATION ICON "rouen.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"  // English US (Unicode)
        BEGIN
            VALUE "CompanyName",      "Rouen Team"
            VALUE "FileDescription",  "Rouen - Modern Card-Based Productivity Dashboard"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "rouen"
            VALUE "LegalCopyright",   "Copyright (C) 2024"
            VALUE "OriginalFilename", "rouen.exe"
            VALUE "ProductName",      "Rouen"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252  // English US, Windows Multilingual
    END
END
