{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"type": "cmake",
			"label": "CMake: configure",
			"command": "configure",
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template configure task"
		},
		{
			"type": "shell",
			"label": "Smart Build (Default)",
			"command": "bash",
			"args": [
				"-c",
				"echo \"Smart Build: Checking available build configurations...\" && if [ -d \"build-vcpkg\" ] && [ -f \"build-vcpkg/CMakeCache.txt\" ] && [ -f \"build-vcpkg/Makefile\" ]; then echo \"Found vcpkg build - building...\" && cmake --build build-vcpkg --parallel; elif [ -d \"build\" ] && [ -f \"build/CMakeCache.txt\" ] && [ -f \"build/Makefile\" ]; then echo \"Found system build - building...\" && cmake --build build --parallel; else echo \"No valid build found. Configuring with system dependencies...\" && cmake -B build -DCMAKE_BUILD_TYPE=Debug && echo \"Building...\" && cmake --build build --parallel; fi"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Smart build: detects existing builds and provides clear guidance"
		},
		{
			"type": "shell",
			"label": "Build with vcpkg",
			"command": "cmake",
			"args": [
				"--build",
				"build-vcpkg",
				"--parallel"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"dependsOn": "Configure with vcpkg",
			"detail": "Build using vcpkg dependencies"
		},
		{
			"type": "shell",
			"label": "Build Debug with vcpkg",
			"command": "cmake",
			"args": [
				"--build",
				"build-vcpkg",
				"--config",
				"Debug",
				"--parallel"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"dependsOn": [
				"Install vcpkg dependencies",
				"Configure Debug with vcpkg"
			],
			"dependsOrder": "sequence",
			"detail": "Build debug version with optimal debugging flags"
		},
		{
			"type": "shell",
			"label": "Configure with vcpkg",
			"command": "sh",
			"args": [
				"-c",
				"mkdir -p build-vcpkg && cd build-vcpkg && cmake .. -DCMAKE_TOOLCHAIN_FILE=../vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_BUILD_TYPE=Debug -DVCPKG_INSTALLED_DIR=../vcpkg_installed"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"detail": "Configure CMake with vcpkg toolchain"
		},
		{
			"type": "shell",
			"label": "Configure Debug with vcpkg",
			"command": "sh",
			"args": [
				"-c",
				"mkdir -p build-vcpkg && cd build-vcpkg && cmake .. -DCMAKE_TOOLCHAIN_FILE=../vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS_DEBUG='-g -O0 -DDEBUG' -DVCPKG_INSTALLED_DIR=../vcpkg_installed"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"detail": "Configure CMake with vcpkg toolchain for optimal debugging"
		},
