{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"type": "cmake",
			"label": "CMake: configure",
			"command": "configure",
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template configure task"
		},
		{
			"type": "shell",
			"label": "Build with vcpkg",
			"command": "cmake",
			"args": [
				"--build",
				"build-vcpkg",
				"--parallel"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"dependsOn": [
				"Install vcpkg dependencies",
				"Configure with vcpkg"
			],
			"dependsOrder": "sequence",
			"detail": "Build using vcpkg dependencies"
		},
		{
			"type": "shell",
			"label": "Build Debug with vcpkg",
			"command": "cmake",
			"args": [
				"--build",
				"build-vcpkg",
				"--config",
				"Debug",
				"--parallel"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"dependsOn": [
				"Install vcpkg dependencies",
				"Configure Debug with vcpkg"
			],
			"dependsOrder": "sequence",
			"detail": "Build debug version with optimal debugging flags"
		},
		{
			"type": "shell",
			"label": "Configure with vcpkg",
			"command": "sh",
			"args": [
				"-c",
				"mkdir -p build-vcpkg && cd build-vcpkg && cmake .. -DCMAKE_TOOLCHAIN_FILE=../vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_BUILD_TYPE=Debug -DVCPKG_INSTALLED_DIR=../vcpkg_installed"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"detail": "Configure CMake with vcpkg toolchain"
		},
		{
			"type": "shell",
			"label": "Configure Debug with vcpkg",
			"command": "sh",
			"args": [
				"-c",
				"mkdir -p build-vcpkg && cd build-vcpkg && cmake .. -DCMAKE_TOOLCHAIN_FILE=../vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS_DEBUG='-g -O0 -DDEBUG' -DVCPKG_INSTALLED_DIR=../vcpkg_installed"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"detail": "Configure CMake with vcpkg toolchain for optimal debugging"
		},
		{
			"type": "shell",
			"label": "Quick Debug Setup",
			"command": "echo",
			"args": [
				"Setting up debug environment..."
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"dependsOn": [
				"Install vcpkg dependencies",
				"Configure Debug with vcpkg",
				"Build Debug with vcpkg"
			],
			"dependsOrder": "sequence",
			"detail": "Complete debug setup: install dependencies, configure, and build"
		},
		{
			"type": "shell",
			"label": "Configure with vcpkg (Release)",
			"command": "cmake",
			"args": [
				"-B",
				"build-vcpkg",
				"-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/vcpkg/scripts/buildsystems/vcpkg.cmake",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DVCPKG_INSTALLED_DIR=${workspaceFolder}/vcpkg_installed"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"detail": "Configure CMake with vcpkg toolchain for Release build"
		},
		{
			"type": "shell",
			"label": "Build with vcpkg (Release)",
			"command": "cmake",
			"args": [
				"--build",
				"build-vcpkg",
				"--config",
				"Release",
				"--parallel"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build Release version using vcpkg dependencies"
		},
		{
			"type": "shell",
			"label": "Clean vcpkg build",
			"command": "rm",
			"args": [
				"-rf",
				"build-vcpkg"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"detail": "Clean vcpkg build directory"
		},
		{
			"type": "shell",
			"label": "Install vcpkg dependencies",
			"command": "${workspaceFolder}/vcpkg/vcpkg",
			"args": [
				"install"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [],
			"detail": "Install vcpkg dependencies from manifest"
		},
		{
			"type": "shell",
			"label": "Update vcpkg baseline",
			"command": "${workspaceFolder}/scripts/update_vcpkg_baseline.sh",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [],
			"detail": "Update vcpkg baseline to latest version"
		},
		{
			"type": "shell",
			"label": "Configure traditional build",
			"command": "cmake",
			"args": [
				"-B",
				"build",
				"-DCMAKE_BUILD_TYPE=Debug"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"detail": "Configure CMake with system dependencies"
		},
		{
			"type": "shell",
			"label": "Build traditional",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--parallel"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build using system dependencies"
		},
		{
			"type": "shell",
			"label": "Run Rouen (vcpkg)",
			"command": "open",
			"args": [
				"build-vcpkg/rouen.app"
			],
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"dependsOn": "Build with vcpkg",
			"detail": "Run the Rouen application built with vcpkg"
		}
	]
}