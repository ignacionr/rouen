    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Debug Rouen (Nix)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-nix/rouen.app/Contents/MacOS/rouen",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "DYLD_LIBRARY_PATH", "value": "${workspaceFolder}/build-nix" },
                { "name": "ROUEN_LOG_LEVEL", "value": "DEBUG" }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Nix Build (Debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for LLDB",
                    "text": "settings set target.inline-breakpoint-strategy always",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "moduleLoad": false,
                "programOutput": true,
                "trace": false
            }
        },
