    "version": "0.2.0",
    "configurations": [
    {
        "name": "🚀 Debug Rouen (vcpkg)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build-vcpkg/rouen.app/Contents/MacOS/rouen",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [
            { "name": "DYLD_LIBRARY_PATH", "value": "${workspaceFolder}/build-vcpkg" },
            { "name": "DYLD_FALLBACK_LIBRARY_PATH", "value": "/usr/local/lib:/opt/homebrew/lib" }
        ],
        "externalConsole": false,
        "MIMode": "lldb",
        "preLaunchTask": "Build with vcpkg",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for LLDB",
                "text": "settings set target.inline-breakpoint-strategy always",
                "ignoreFailures": true
            }
        ],
        "logging": {
            "moduleLoad": false,
            "programOutput": true,
            "trace": false
        }
    },
