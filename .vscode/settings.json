        "source_location": "cpp",
        "typeindex": "cpp",
        "csignal": "cpp",
        "execution": "cpp",
        "__hash_table": "cpp",
        "__locale": "cpp",
        "*.inc": "cpp",
        "locale": "cpp",
        // Test-specific file associations
        "**/tests/**/*.cpp": "cpp",
        "**/tests/**/*.hpp": "cpp",
        "test_*.cpp": "cpp",
        "*_test.cpp": "cpp",
        "*.gtest": "cpp"
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build-vcpkg/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/build-vcpkg/_deps/imgui-src",
        "${workspaceFolder}/build-vcpkg/_deps/imgui-src/backends",
        "${workspaceFolder}/external/imguicolortextedit",
        "${workspaceFolder}/src/helpers",
        "${workspaceFolder}/vcpkg_installed/arm64-osx/include",
        "${workspaceFolder}/vcpkg_installed/arm64-osx/include/SDL2"
    ],
    "C_Cpp.default.defines": [
        "CURL_STATICLIB",
        "DEBUG_BUILD",
        "DEBUG_ROUEN=1",
        "GL_SILENCE_DEPRECATION",
        "TINYXML2_DEBUG",
        "_FILE_OFFSET_BITS=64",
        "_GLIBCXX_DEBUG=1",
        "_LIBCPP_DEBUG=1"
    ],
    "C_Cpp.default.intelliSenseMode": "macos-clang-arm64",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.intelliSenseEngine": "default",
    "cmake.buildDirectory": "${workspaceFolder}/build-vcpkg",
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },
    "cmake.generator": "Unix Makefiles",
    "cmake.buildTask": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.defaultVariants": {
        "buildType": {
            "default": "debug",
            "choices": {
                "debug": {
                    "short": "Debug",
                    "long": "Emit debug information",
                    "buildType": "Debug"
                },
                "release": {
                    "short": "Release",
                    "long": "Optimize generated code",
                    "buildType": "Release"
                }
            }
        }
    },
    "debug.allowBreakpointsEverywhere": true,
    "debug.inlineValues": "on",
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.console.wordWrap": false,
    "debug.console.fontSize": 12,
    "C_Cpp.debugShortcut": true,
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autocompleteAddParentheses": true,
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "{ BasedOnStyle: LLVM, IndentWidth: 4, TabWidth: 4, UseTab: Never }",
    
    // Testing-specific settings
    "cmake.testDirectory": "${workspaceFolder}/tests",
    "cmake.testArgs": [
        "--output-on-failure",
        "--verbose"
    ],
    "testExplorer.useNativeTesting": true,
    "testExplorer.mergeSuites": true,
    "testExplorer.sort": "location",
    "testExplorer.onStart": "reset",
    "testExplorer.onReload": "reset",
    "testExplorer.showCollapseButton": true,
    "testExplorer.showExpandButton": true,
    "testExplorer.showOnRun": true,
    "testExplorer.hideEmptyLog": false,
    "testExplorer.hideWhen": "never",
    
    // C++ Test settings for Google Test integration
    "C_Cpp.dimInactiveRegions": false,
    "C_Cpp.enhancedColorization": "enabled",
    "C_Cpp.inteltiSenseUpdateDelay": 500,
    
    // Terminal settings for test output
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontFamily": "SF Mono, Monaco, 'Courier New', monospace",
    
    // Build and task settings
    "task.autoDetect": "on",
    "task.problemMatchers.autoDetect": "on",
    "task.showDecorations": true,
    "task.allowAutomaticTasks": "on",
    
    // Problems panel settings
    "problems.autoReveal": true,
    "problems.showCurrentInStatus": true,
    
    // CMake extension settings
    "cmake.buildBeforeRun": true,
    "cmake.clearOutputBeforeBuild": true,
    "cmake.showSystemKits": false,
    "cmake.configureOnOpen": false,
    "cmake.automaticReconfigure": false,
    
    // Search settings to include test results
    "search.exclude": {
        "**/build*": false,
        "**/build-tests": false,
        "**/Testing": false
    },
    
    // CTest integration
    "cmake.ctest.parallelJobs": 0,
    "cmake.ctest.allowParallelJobs": true,
    "cmake.options.statusBarVisibility": "visible",
    "cmake.options.advanced": {
        "test": {
            "statusBarVisibility": "visible"
        }
    },
    
    // Build output settings
    "output.smartScroll.enabled": true,
    "terminal.integrated.enablePersistentSessions": false
}